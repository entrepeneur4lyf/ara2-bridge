{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/entrepeneur4lyf/ara2-bridge/docs/conformance/evidence-schema.json",
  "title": "ARA2 Bridge CI Evidence Fragment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "head_sha",
    "workflow",
    "workflow_run_id",
    "job_id",
    "target",
    "toolchain",
    "command",
    "conclusion",
    "input_hashes",
    "output_hashes"
  ],
  "properties": {
    "schema": { "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "workflow": { "type": "string", "minLength": 1 },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "toolchain": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "conclusion": { "enum": ["success", "failure", "cancelled"] },
    "input_hashes": { "$ref": "#/$defs/hashes" },
    "output_hashes": { "$ref": "#/$defs/hashes" }
  },
  "$defs": {
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$"
      }
    }
  }
}
